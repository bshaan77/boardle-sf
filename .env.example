# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# X (Twitter) API Bearer Token — get one at https://developer.x.com
# Required for searching billboard images from X
X_BEARER_TOKEN=""

# OpenAI API Key — get one at https://platform.openai.com/api-keys
# Required for AI-powered image validation (uses GPT-4 Vision)
OPENAI_API_KEY=""

# Anthropic API Key — get one at https://console.anthropic.com/settings/keys
# Required for Claude-powered query generation and optimization
ANTHROPIC_API_KEY=""

# Automated Search Configuration (Optional)
# Set to "true" to enable automated daily searches in production
ENABLE_CRON="false"

# Cron schedule for automated searches (default: 9 AM daily)
# Format: minute hour day month weekday (see https://crontab.guru)
# Examples:
#   "0 9 * * *"    - Every day at 9 AM
#   "0 */6 * * *"  - Every 6 hours
#   "0 9 * * 1"    - Every Monday at 9 AM
CRON_SCHEDULE="0 9 * * *"

# Secret token to authenticate cron API calls
# Generate a random string (e.g., using `openssl rand -hex 32`)
# Required in production to protect the /api/cron/search-billboards endpoint
CRON_SECRET=""

# Daily billboard goal (default: 3)
# Smart search will keep searching until this many valid billboards are found
DAILY_BILLBOARD_GOAL="3"

# Max daily AI cost in USD (default: 1.0)
# Smart search will stop if it reaches this cost limit OR finds enough billboards
# Whichever comes first
MAX_DAILY_AI_COST="1.0"
